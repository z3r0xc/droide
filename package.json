{
  "name": "droide",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Droide — a terminal coding agent: TypeScript product layer with a Rust native helper.",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "droide": "./bin/droide.mjs"
  },
  "scripts": {
    "cli": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:parity": "node tests/parity/run.mjs --check",
    "test:rust": "cargo test --workspace",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.json\"",
    "gaps": "node tools/gaps.mjs",
    "gaps:check": "node tools/gaps.mjs --check",
    "brand:check": "node tools/brand-check.mjs",
    "native:build": "cargo build -p droide-native",
    "test:native": "node tools/run-native-tests.mjs",
    "verify": "npm run typecheck && npm run format:check && npm run gaps:check && npm test && npm run test:parity",
    "verify:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && npm run test:native"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ink": "^7.1.1",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z3r0xc/droide.git"
  },
  "bugs": {
    "url": "https://github.com/z3r0xc/droide/issues"
  },
  "homepage": "https://github.com/z3r0xc/droide#readme",
  "keywords": [
    "cli",
    "agent",
    "coding-agent",
    "terminal",
    "typescript",
    "rust"
  ],
  "files": [
    "src/**/*.ts",
    "bin/",
    "README.md",
    "README.ru.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
